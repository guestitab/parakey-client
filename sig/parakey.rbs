# Public API of the gem, mirroring the inline `# @rbs` annotations in lib/.
# Shipped with the gem so host apps pick it up through `rbs collection`.
module Parakey
  VERSION: ::String

  BASE_URL: ::String
  RETRY_OPTIONS: ::Hash[::Symbol, untyped]

  def self.configure: () { (Config) -> void } -> void
  def self.config: () -> Config

  def self.connection: () -> untyped
  def self.request: (::Symbol method, ::String path, ?params: ::Hash[::Symbol, untyped]?, ?accepted_statuses: ::Array[::Integer]) -> untyped

  class Error < ::StandardError
  end

  # Raised by operations before any network call when the arguments are unusable.
  class ArgumentError < Error
  end

  # A rejected Parakey response; #unapplied? marks a write that never landed.
  class ApiError < Error
    attr_reader status: ::Integer

    def initialize: (::String message, status: ::Integer) -> void

    def unapplied?: () -> bool
  end

  class Config
    attr_accessor access_token: ::String?
    attr_accessor domain_id: ::String?
    attr_accessor base_url: ::String
    attr_accessor timeout: (::Integer | ::Float)?
  end

  # #call! returns the same Result as #call, raising the failure instead of
  # wrapping it — hence the `alias call! call` on every operation below.
  module Operation
    def call!: (*untyped, **untyped) -> untyped
  end

  module AccessGrants
    KIND_REGULAR: ::String
    KIND_TIME_CONTROLLED: ::String
    KINDS: ::Array[::String]
    STATUS_ACTIVE: ::String
    STATUS_INACTIVE: ::String

    class Create
      def call: (attributes: ::Hash[::Symbol, untyped]) -> ::Dry::Monads::Result[::Hash[::Symbol, untyped]]
      alias call! call
    end

    class Delete
      def call: (attributes: ::Hash[::Symbol, untyped]) -> ::Dry::Monads::Result[bool]
      alias call! call
    end

    class Index
      def call: (?skip: ::Integer, ?take: ::Integer) -> ::Dry::Monads::Result[::Array[::Hash[::Symbol, untyped]]]
      alias call! call
    end
  end

  module AccessEvents
    class Normalize
      SYNC_ACTIVITIES: ::Array[::String]

      def call: (item: ::Hash[::Symbol, untyped]) -> ::Dry::Monads::Result[::Hash[::Symbol, untyped]]
      alias call! call
    end
  end

  module Keys
    class Index
      ACCESS_FILTERS: ::Hash[::Symbol, untyped]

      def call: (?skip: ::Integer, ?take: ::Integer, ?filters: ::Hash[::Symbol, untyped]) -> ::Dry::Monads::Result[::Array[::Hash[::Symbol, untyped]]]
      alias call! call
    end
  end

  module Locks
    class Index
      BATTERY_CHARGES: ::Hash[::String, ::Integer]
      ACCESS_BATCH_SIZE: ::Integer
      STATUS_ONLINE: ::String

      def call: (?skip: ::Integer, ?take: ::Integer) -> ::Dry::Monads::Result[::Array[::Hash[::Symbol, untyped]]]
      alias call! call
    end
  end

  module Members
    class Index
      def call: (?skip: ::Integer, ?take: ::Integer, ?filters: ::Hash[::Symbol, untyped]) -> ::Dry::Monads::Result[::Array[::Hash[::Symbol, untyped]]]
      alias call! call
    end

    class Destroy
      def call: (email: ::String?) -> ::Dry::Monads::Result[bool]
      alias call! call
    end
  end
end
